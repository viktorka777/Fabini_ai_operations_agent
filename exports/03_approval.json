    {
      "id": "2199c6b3-9a95-4061-89b4-7e9063ed5ddb",
      "name": "Check cooldown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Check approval lock').first().json;\nconst raw=$input.first().json;\nconst proposal=p.proposal;\nconst key=proposal&&typeof proposal.order_id==='string'&&['retry_sync','create_ticket'].includes(proposal.action)\n ?'fabini:vk:cooldown:'+proposal.order_id+':'+proposal.action:null;\nconst reliable=key&&raw&&typeof raw==='object'&&!Array.isArray(raw)\n &&Object.keys(raw).length===1&&!Object.prototype.hasOwnProperty.call(raw,'error')\n &&Object.prototype.hasOwnProperty.call(raw,key)&&typeof raw[key]==='number'\n &&Number.isSafeInteger(raw[key])&&raw[key]>=1;\nconst n=reliable?raw[key]:null;\nreturn [{json:{...p,window_ok:n===1,http_status:n===1?200:n>1?429:503,\n status:n===1?'locked':'blocked',error:n===1?null:n>1?'action_limit_reached':'lock_store_unavailable'}}];\n"
      }
