    },
    {
      "id": "2abc694d-fc14-45f4-a51e-ba7900b1c1b6",
      "name": "Check approval lock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p=$('Validate proposal').first().json;\nconst raw=$input.first().json;\nconst key=typeof p.proposal_id==='string'?'fabini:vk:claim:'+p.proposal_id:null;\nconst reliable=key&&raw&&typeof raw==='object'&&!Array.isArray(raw)\n &&Object.keys(raw).length===1&&!Object.prototype.hasOwnProperty.call(raw,'error')\n &&Object.prototype.hasOwnProperty.call(raw,key)&&typeof raw[key]==='number'\n &&Number.isSafeInteger(raw[key])&&raw[key]>=1;\nconst n=reliable?raw[key]:null;\nreturn [{json:{...p,lock_ok:n===1,http_status:n===1?200:n>1?409:503,\n status:n===1?'locked':'blocked',error:n===1?null:n>1?'approval_already_used':'lock_store_unavailable'}}];\n"
      }
    },
