    {
      "id": "6f3e48ab-8671-4562-b03b-5c22266a0afe",
      "name": "Validate approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b=$input.first().json.body||{};const ok=typeof b.proposal_id==='string'&&/^VK-[0-9]+-(retry_sync|create_ticket)$/.test(b.proposal_id)&&['approve','deny'].includes(b.decision);\nreturn [{json:{valid:ok,proposal_id:ok?b.proposal_id:null,decision:b.decision,http_status:ok?200:422,status:ok?'ready':'invalid_request',message:ok?'':'proposal_id a rozhodnutí approve/deny jsou povinné'}}];"
      }
    },
    {
      "id": "90b7d09e-1b9c-49c0-a61a-07d5fc401456",
      "name": "Valid approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        460,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "e0fb2903-e194-43be-9af5-25c357e5555b",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "9c794847-d4f6-42fb-8382-dcea88436813",
      "name": "Read bound proposal",
