      "position": [
        700,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/fabini-vk-mock",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({tool:\"inspect_proposal\",proposal_id:$json.proposal_id,decision:$json.decision}) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
