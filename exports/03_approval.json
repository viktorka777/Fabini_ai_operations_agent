      "name": "Claim approval",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1420,
        0
      ],
      "parameters": {
        "operation": "incr",
        "key": "=fabini:vk:claim:{{ $json.proposal_id }}",
        "expire": true,
        "ttl": 3600
      },
      "onError": "continueRegularOutput",
      "credentials": {
        "redis": {
          "name": "FABINI — Redis (demo locks)"
        }
