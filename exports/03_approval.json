    {
      "id": "3a3317b5-0f98-4559-aef3-0b7da9f464a0",
      "name": "Validate proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json;const b=r.body||{};const req=$('Validate approval').first().json;\nreturn [{json:{...req,...b,valid:r.statusCode===200&&b.status==='valid',http_status:r.statusCode||503,status:r.statusCode===200?'valid':'blocked',error:b.error||r.error||null}}];"
      }
    },
